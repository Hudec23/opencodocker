# Anthropic — needed if opencode.json uses any anthropic/* model (e.g. for planning)
ANTHROPIC_API_KEY=sk-ant-...

# vLLM — set both if using a local vLLM server
# VLLM_ENDPOINT is the real address of your vLLM server (agent never sees it directly)
VLLM_ENDPOINT=https://your-tunnel-or-ip:port
VLLM_API_KEY=your-vllm-key-or-any-string-if-no-auth

# GitHub — fine-grained PAT, single repo, Contents read+write
GH_TOKEN=github_pat_...

# LAN blocking (Linux only, requires root)
# Set BLOCK_LOCAL=true to prevent agent from reaching private IP ranges.
# iptables rules are scoped to the agent container only — nginx proxy and dind unaffected.
BLOCK_LOCAL=false

# Comma-separated IPs/CIDRs the agent is allowed to reach even with BLOCK_LOCAL=true.
# Add your vLLM machine here if it's on a local IP (not needed for tunnel URLs).
# Example: ALLOWED_HOSTS=192.168.1.50,10.0.0.5/32
ALLOWED_HOSTS=

BRAVE_API_SEARCH_KEY=your-brave-api-key
