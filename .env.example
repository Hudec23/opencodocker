# Anthropic — needed if opencode.json uses any anthropic/* model (e.g. for planning)
ANTHROPIC_API_KEY=sk-ant-...

# vLLM — set both if using a local vLLM server
# VLLM_ENDPOINT is the real address of your vLLM server (never seen by the agent directly)
# The agent connects to the socat proxy which forwards only to this host:port
VLLM_ENDPOINT=http://192.168.1.50:8000
VLLM_API_KEY=your-vllm-key-or-any-string-if-no-auth

# GitHub — needed for git push inside the agent
# Create a fine-grained PAT: Settings → Developer settings → Fine-grained tokens
# Repository access: single repo, Contents: Read and Write
GH_TOKEN=github_pat_...
